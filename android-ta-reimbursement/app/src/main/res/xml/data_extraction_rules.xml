<?xml version="1.0" encoding="utf-8"?>
<!-- Client invoices and TA data must never leave the phone automatically:
     exclude everything from Google cloud backup and device-to-device transfer.
     Users back up explicitly via Settings > Back up all data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
